# Copy to .env.local for development, or set these in your host's dashboard.
#
# Every variable the code actually reads is listed here. Anything not in this
# file is not consulted at runtime.


# ---------------------------------------------------------------
# Site
# ---------------------------------------------------------------

# Public base URL — used for canonical links, OG tags, sitemap and robots.
# Must include the protocol and no trailing slash.
#
# Optional. If unset, lib/seo.ts falls back to RAILWAY_PUBLIC_DOMAIN (which
# Railway injects automatically), then to a hard-coded default. Set this once
# you have a custom domain, or canonical tags will advertise the wrong host.
NEXT_PUBLIC_SITE_URL=http://localhost:3005


# ---------------------------------------------------------------
# Firebase — browser SDK (required)
# ---------------------------------------------------------------
#
# These are NOT secrets. They ship in the JS bundle by design; every Firebase
# web app exposes them. Access is controlled by Firestore security rules and
# Firebase Auth, not by hiding these values.
#
# Find them in: Firebase console > Project settings > General > Your apps >
# SDK setup and configuration.
#
# If any are missing, sign-in fails with an explicit "Firebase is not
# configured" message rather than a generic auth error.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=


# ---------------------------------------------------------------
# Firebase Admin — server only (required)
# ---------------------------------------------------------------
#
# This service account bypasses ALL Firestore security rules. Never expose it
# to the browser and never commit a filled-in .env.local.
#
# Generate at: Firebase console > Project settings > Service accounts >
# Generate new private key. The downloaded JSON contains all three values.
#
# FIREBASE_PROJECT_ID must match NEXT_PUBLIC_FIREBASE_PROJECT_ID — the
# middleware checks the session cookie's issuer against the public one while
# the Admin SDK verifies against this one, so a mismatch signs users out in a
# loop.

FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Paste the private_key value from the JSON, quoted, keeping the \n escapes:
#   FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# lib/firebase/admin.ts normalises the common manglings (real newlines, \n,
# and trailing backslashes), so most paste styles work.
FIREBASE_PRIVATE_KEY=


# ---------------------------------------------------------------
# FFmpeg (optional)
# ---------------------------------------------------------------
#
# Leave both unset in almost all cases.
#
# The binaries ship as npm dependencies (ffmpeg-static, ffprobe-static), so
# they are present after npm install regardless of what the build image
# contains. lib/server/media.ts prefers these overrides, then the bundled
# binaries, then PATH. Set them only when pointing at a system build.

# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# ---------------------------------------------------------------
# Email mailbox verification (OPTIONAL — set ONE of these)
# ---------------------------------------------------------------
#
# Without a key here, sign-up can only reject addresses whose DOMAIN cannot
# receive mail (invented domains, example.com, disposable providers). It
# CANNOT tell ali1234@gmail.com from a real Gmail user, because both sit
# behind the same MX records.
#
# Deciding that needs an SMTP conversation with the recipient's mail server,
# and Railway — like effectively every cloud host — blocks outbound port 25,
# so the app cannot do it directly at any price. These services can.
#
# Set exactly one. Each has a free tier big enough for early traffic:
#
#   ZeroBounce     https://zerobounce.net        100 free credits
#   Abstract API   https://abstractapi.com       100 free/month
#   Hunter         https://hunter.io             25 free/month
#
# ZEROBOUNCE_API_KEY=
# ABSTRACT_EMAIL_API_KEY=
# HUNTER_API_KEY=
# ---------------------------------------------------------------
# Lemon Squeezy — billing (required for paid plans)
# ---------------------------------------------------------------
#
# Without these, the Free plan works but the Pro/Business buttons send the
# user to a "billing isn't set up" notice instead of a checkout. Nothing
# else in the app is affected.
#
# API key:  Lemon Squeezy dashboard > Settings > API > create a new key.
#           Server-only secret — never prefix it with NEXT_PUBLIC_.
# Store ID: Settings > Stores — the numeric id of your store.
# Webhook secret: Settings > Webhooks — the signing secret you set when you
#           create the webhook (see below). Must match exactly or every
#           webhook is rejected as unsigned.

LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Variant IDs — one per plan and interval.
#
# In Lemon Squeezy a "product" has one or more "variants" (a price). Create a
# Pro product with a Monthly and a Yearly variant, and a Business product the
# same way, then paste each variant's id here.
#
# Find a variant id: open the product > click the variant > the id is in the
# URL and on the variant page. These decide which plan a purchase grants, so
# a wrong id hands out the wrong plan.

LEMONSQUEEZY_VARIANT_PRO_MONTHLY=
LEMONSQUEEZY_VARIANT_PRO_YEARLY=
LEMONSQUEEZY_VARIANT_BUSINESS_MONTHLY=
LEMONSQUEEZY_VARIANT_BUSINESS_YEARLY=

# Webhook URL to register in Lemon Squeezy (Settings > Webhooks):
#   https://YOUR_DOMAIN/api/billing/webhook
# Subscribe it to at least these events — this is the exact set the webhook
# route acts on, so leaving one out means that transition is never applied:
#
#   Grant or keep paid access:
#     subscription_created, subscription_updated, subscription_resumed,
#     subscription_unpaused, subscription_payment_success,
#     subscription_cancelled
#
#   End paid access:
#     subscription_expired, subscription_paused, order_refunded
#
# subscription_cancelled GRANTS rather than revokes: a cancelled subscription
# stays active until its paid period ends, and subscription_expired is what
# finally drops the user to Free.

