# Copy to .env.local for development, or set these in your host's dashboard.

# Public base URL — used for canonical links, OG tags, sitemap and robots.
# Must include the protocol and no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required. Signs the session JWT — must be at least 32 characters.
# Generate one with: openssl rand -base64 32
# Without it, middleware fails closed and every protected route redirects
# to /sign-in.
AUTH_SECRET=

# ---------------------------------------------------------------
# Added in later phases — listed here so deployment config is ready.
# ---------------------------------------------------------------

# DATABASE_URL=           # postgres://user:pass@host:5432/audiostudio