rules_version = '2';

// =====================================================
// Firestore security rules
//
// These govern DIRECT access from browsers using the client SDK.
// The Admin SDK (lib/firebase/admin.ts) bypasses them entirely, which is
// why the server layer does its own ownership checks.
//
// Default posture: deny everything, then allow narrowly.
// Deploy with:  firebase deploy --only firestore:rules
// =====================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Fields a client must never set on itself.
    //
    // The subscription fields are written only by the verified Lemon Squeezy
    // webhook, through the Admin SDK, which bypasses these rules. A browser
    // must not be able to touch them: customerPortalUrl in particular is what
    // /api/billing/portal redirects to, so leaving it writable let an account
    // point its own portal link anywhere.
    // storageUsedBytes belongs here too: it is the ONLY input to the storage
    // quota check, and the server adjusts it with increment(). A client that
    // could set it — to a negative number, say — would have unlimited storage
    // while every screen still showed a tidy figure.
    function noPrivilegeEscalation() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(['plan', 'storageUsedBytes', 'storageLimitBytes',
                 'filesProcessed', 'processingSeconds', 'createdAt',
                 'subscriptionStatus', 'subscriptionId',
                 'subscriptionRenewsAt', 'subscriptionEndsAt',
                 'subscriptionEventAt',
                 'lemonSqueezyCustomerId', 'customerPortalUrl']);
    }

    // ---- user profile -------------------------------
    match /users/{uid} {
      allow read: if isOwner(uid);

      // Creation happens server-side on first sign-in, but allow the
      // owner to create their own doc as a fallback.
      allow create: if isOwner(uid)
                    && request.resource.data.plan == 'free'
                    && request.resource.data.storageUsedBytes == 0;

      // A client may edit its display name and nothing else. Without
      // noPrivilegeEscalation() a user could simply set plan = 'studio'.
      allow update: if isOwner(uid) && noPrivilegeEscalation();

      // Account deletion is server-side only, so it can clean up
      // subcollections and stored files first.
      allow delete: if false;

      // ---- owned subcollections ---------------------
      //
      // READ-ONLY to clients. Every write goes through the API routes, which
      // use the Admin SDK.
      //
      // These documents are not plain user content: `storagePath` in each one
      // names a Storage object that the server later signs a URL for, streams,
      // or deletes — and `sizeBytes` is what storageUsedBytes is incremented
      // and decremented by. The old rules validated name and sizeBytes but
      // let an owner write ANY other field, so a document could be pointed at
      // users/<someone-else>/... and then downloaded or deleted through the
      // app's own endpoints.
      //
      // Validating storagePath in rules would mean re-deriving the server's
      // path scheme here and keeping the two in step forever. Since nothing
      // in this app writes Firestore from the browser (lib/firebase/client.ts
      // initialises Auth and nothing else), refusing client writes outright is
      // both simpler and stricter. Owner read stays: it costs nothing and
      // leaves the door open for a read-only client listener later.
      match /projects/{projectId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /library/{itemId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Trash is written only by the server (moveToTrash uses a batch that
      // must stay consistent), so clients may read but not write.
      match /trash/{itemId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // ---- everything else ----------------------------
    // Any path not matched above is denied. This catch-all makes that
    // explicit rather than implicit.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
