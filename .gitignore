# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
# ...and any copy of them. A .bak of .env.local still holds the live
# FIREBASE_PRIVATE_KEY, which bypasses every Firestore security rule.
.env*.local.*
*.bak

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime scratch — the video player wrote uploads here and three 5 MB
# videos ended up committed, shipping 15 MB to every clone and deploy.
.tmp-video-uploads/

# build output kept out of version control
build.log
build-output.txt
